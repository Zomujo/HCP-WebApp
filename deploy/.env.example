# Build settings for one environment of the HCP web app on the VPS.
#
# Copy to /opt/hcp-web/.env.staging or /opt/hcp-web/.env.production, owned by
# root, mode 600 (deploy.sh refuses any other mode).
#
# Both values are baked into the browser bundle when deploy.sh builds the
# image, so anyone using the site can read them: they are not secrets, and no
# secret may ever be added here. Changing one takes a new deploy, not a
# restart.
#
# Format: KEY=value, one per line, no "export " prefix, no quotes needed.

# The public https:// address of this environment's DNH API: the origin only,
# no path and no trailing slash. Staging and production must differ; deploy.sh
# refuses two files with the same value. The API's CORS_ORIGINS must allow
# this web app's own address.
NEXT_PUBLIC_API_URL=https://api-staging.example.gov.gh

# The OAuth web client ID for Google sign-in. It must also be in the API's
# GOOGLE_CLIENT_ID list, or the API refuses the sign-in. In the Google Cloud
# console, the client's "Authorized JavaScript origins" must include this web
# app's https:// address.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
