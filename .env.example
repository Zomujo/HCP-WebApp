# Settings for running the web app locally. Copy to .env.local and fill in.
#
# Both values are baked into the browser bundle when the app is built
# (next build), so they are public: never put a secret here. On the VPS the
# same keys live in /opt/hcp-web/.env.<environment>; see deploy/RUNBOOK.md.

# The DNH API this build talks to, without a trailing slash and without
# /api/v1, e.g. https://api-staging.example.gov.gh or http://localhost:4815.
NEXT_PUBLIC_API_URL=

# The OAuth web client ID for Google sign-in. It must also be listed in the
# API's GOOGLE_CLIENT_ID, or the API refuses the token.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
